{
  "name": "agent-learn",
  "version": "0.1.0",
  "private": true,
  "description": "A step-by-step project for learning how to build a coding agent from scratch.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agent-learn": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "start": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "verify:step": "tsx src/verification/verify-step.ts",
    "verify:all": "tsx src/verification/verify-step.ts 34",
    "test:steps": "vitest run --config vitest.steps.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
